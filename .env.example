# Copiar a .env y completar con valores reales. .env NUNCA se commitea (ver .gitignore).
# Generar secretos con: python -c "import secrets; print(secrets.token_urlsafe(48))"
 
# --- Base de datos ---
POSTGRES_USER=lafs
POSTGRES_PASSWORD=cambia-esto-por-un-valor-generado
POSTGRES_DB=lafs
DATABASE_URL=postgresql+psycopg://lafs:cambia-esto-por-un-valor-generado@db:5432/lafs
 
# --- Seguridad ---
# Clave para firmar los JWT. 48+ bytes aleatorios, nunca reutilizar entre entornos.
SECRET_KEY=cambia-esto-por-un-valor-generado
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
 
# Usuario administrador con el que arranca el sistema (lo crea la
# migración del issue #4). Como cualquier usuario nuevo, su contraseña
# queda igual al documento hasta que inicie sesión y la cambie.
ADMIN_SEED_DOCUMENTO=1000000000
ADMIN_SEED_PASSWORD=1000000000
 
# --- Entorno ---
ENVIRONMENT=development
# En producción: false. Nunca exponer swagger/redoc públicamente en producción.
API_DOCS_ENABLED=true
 
# --- Correo (alertas del worker) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Orígenes permitidos para peticiones CORS, separados por coma (el
# frontend, issue #6). El valor por defecto ya cubre `npm run dev` de
# la app Android en modo web (localhost:5173), `npm run dev` del panel
# web de administración (localhost:5174, issue #49), la API accedida
# vía Caddy en localhost, y la app Android empaquetada con Capacitor —
# normalmente no hace falta tocarlo en desarrollo.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost,capacitor://localhost

# --- Panel web del administrador (issue #49) ---
# URL base que el panel compilado usa para llamar a la API — se
# hornea en el build de Vite (ver web/Dockerfile), así que en
# producción debe ser el dominio real donde quede Caddy, no localhost.
PANEL_ADMIN_API_URL=http://localhost:81