# Copiar a .env y completar con valores reales. .env NUNCA se commitea (ver .gitignore).
# Generar secretos con: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Base de datos ---
POSTGRES_USER=lafs
POSTGRES_PASSWORD=cambia-esto-por-un-valor-generado
POSTGRES_DB=lafs
DATABASE_URL=postgresql+psycopg://lafs:cambia-esto-por-un-valor-generado@db:5432/lafs

# --- Seguridad ---
# Clave para firmar los JWT. 48+ bytes aleatorios, nunca reutilizar entre entornos.
SECRET_KEY=cambia-esto-por-un-valor-generado
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Entorno ---
ENVIRONMENT=development
# En producción: false. Nunca exponer swagger/redoc públicamente en producción.
API_DOCS_ENABLED=true

# --- Correo (alertas del worker) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
