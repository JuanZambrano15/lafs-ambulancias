# Reverse proxy para la API, y el panel web del administrador (issue
# #49) servido como estáticos bajo /admin. En local corre en HTTP
# (puerto 80, mapeado a 81 en el host — ver docker-compose.yml); en
# producción, apuntando a un dominio real en vez de ":80", Caddy emite
# y renueva certificados TLS automáticamente sin configuración extra.
:80 {
    # /srv/admin lo siembra el contenedor `web-build` (ver
    # docker-compose.yml y web/Dockerfile) — el build de Vite ya usa
    # `base: '/admin/'`, así que sus assets referencian rutas que
    # coinciden con este `root`.
    handle /admin* {
        root * /srv
 
        # Los archivos de /admin/assets (JS, CSS, imágenes) llevan un hash
        # en el nombre, así que nunca cambian: se pueden guardar en caché
        # para siempre. Y si alguno no existe se responde 404, NUNCA el
        # index.html -- antes, un .css que no estaba (p. ej. de un build
        # anterior, justo después de reconstruir el panel) recibía el
        # index.html con código 200, el navegador lo guardaba en caché
        # como si fuera la hoja de estilos y la descartaba por no ser CSS:
        # al recargar, el panel aparecía sin ningún estilo.
        @asset_existente {
            path /admin/assets/*
            file
        }
        handle @asset_existente {
            header Cache-Control "public, max-age=31536000, immutable"
            file_server
        }
        handle /admin/assets/* {
            # `no-store` para que el navegador tampoco guarde el 404.
            header Cache-Control "no-store"
            respond 404
        }
 
        # Cualquier otra ruta que no sea un archivo real (las rutas de
        # react-router, como /admin/usuarios) cae al index del panel,
        # que decide la pantalla en el navegador. `no-cache`: el
        # navegador siempre pregunta si hay un index.html nuevo, para que
        # después de reconstruir el panel no se quede con uno viejo que
        # apunta a assets que ya no existen.
        handle {
            header Cache-Control "no-cache"
            try_files {path} /admin/index.html
            file_server
        }
    }
 
    handle {
        reverse_proxy api:8000
    }
}