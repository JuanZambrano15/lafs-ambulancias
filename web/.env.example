# URL base de la API (ver api/.env.example y app/.env.example — mismo
# valor que usa la app Android en desarrollo, cuando el backend corre
# suelto con `uvicorn` en el puerto 8000). En producción, Caddy sirve
# este panel bajo /admin/ en el mismo dominio que la API (ver
# infra/Caddyfile), así que ahí la variable de build apunta a ese
# dominio real en vez de localhost.
VITE_API_URL=http://localhost:8000